# Copia este archivo como robot_supertrend/.env y completa tus datos.
# .env esta en .gitignore: NUNCA se sube a GitHub. No pegues claves en el codigo.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_ENV=DEMO
CAPITAL_ACCOUNT_NAME=dm
BOT_ENABLED=true
BOT_DRY_RUN=false
BOT_ALLOW_LIVE=false

# Riesgo (valores probados en el backtest de 2 años; ver research/scaling_1h)
RISK_TOTAL_PCT=1.5
RISK_STOP_ATR=1.0
RISK_ADD_EVERY_ATR=1.0
RISK_DAILY_LOSS_PCT=3
RISK_MAX_DRAWDOWN_PCT=25
# RISK_MAX_UNITS=2          # tope manual opcional de posiciones simultaneas

# Señal
BOT_MAX_SIGNAL_AGE=2
# BOT_SIZING=fixed          # para volver al tamaño fijo de BOT_SIZE
# BOT_SIZE=0.1

# Noticias
NEWS_FILTER=true
NEWS_MINUTES_BEFORE=30
NEWS_MINUTES_AFTER=45

RUNNER_INTERVAL_SECONDS=60
