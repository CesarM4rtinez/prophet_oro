# Copia este archivo como .env y completa tus credenciales reales.
# .env NUNCA se sube a git (ya esta cubierto por el .gitignore raiz del repo).

# Capital.com API (https://capital.com) - broker de CFDs
CAPITAL_API_USER=tu_email@ejemplo.com
CAPITAL_API_PASSWORD=tu_password
CAPITAL_API_KEY=tu_api_key
CAPITAL_ACCOUNT_NAME=CDFs

# Entorno por defecto al abrir la Terminal de Trading: DEMO o LIVE
CAPITAL_DEFAULT_ENV=DEMO
